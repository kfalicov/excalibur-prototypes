{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "es2017",
    "outDir": "../../dist/out-tsc",
    "types": [
      "node",
      "@webgpu/types"
    ],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "declaration": true
  },
  "exclude": [
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "include": [
    "**/*.ts",
    "src/assets/**/*.json"
  ]
}